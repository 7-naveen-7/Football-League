# Rename this file to .env and fill in your own values

# App / session
PORT=3000
SESSION_SECRET=secret

# Admin login
ADMIN_USERNAME=admiralgeneralaladeen
ADMIN_PASSWORD=aladeen

# Currency symbol shown for player values and purses: € (default) or £
CURRENCY_SYMBOL=€

# Leave false. Google Drive photo links usually can't be auto-downloaded, so
# players get a sample avatar on import and you add real photos with the
# "Bulk Photo Upload" tool in the admin console.
ENABLE_PHOTO_DOWNLOAD=false
